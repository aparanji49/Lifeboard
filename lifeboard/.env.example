# Copy to .env.local and fill in real values. Never commit .env* with secrets.
# https://next-auth.js.org/configuration/options#environment-variables

# --- App URL (production: your canonical HTTPS origin) ---
NEXTAUTH_URL=http://localhost:3000

# --- NextAuth: generate with `openssl rand -base64 32` (minimum ~32 bytes random) ---
NEXTAUTH_SECRET=

# --- PostgreSQL (Prisma) ---
DATABASE_URL=
# Optional: direct connection for migrations (e.g. Neon/Vercel split URLs)
DIRECT_URL=

# --- Google OAuth (Calendar) — from Google Cloud Console ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Must match an authorized redirect URI in Google Cloud (e.g. https://yourdomain.com/api/auth/callback/google)
GOOGLE_REDIRECT_URI=http://localhost:3000/api/google/oauth2callback

# --- OpenAI (scheduling + agent) ---
OPENAI_API_KEY=

# --- Optional widgets (server-only; proxied via /api/weather and /api/quote) ---
OPENWEATHER_API_KEY=
API_NINJAS_KEY=

# --- Debug: set TIME_DEBUG=1 to enable [time-debug] logs in production (still redacts user text) ---
# TIME_DEBUG=1
